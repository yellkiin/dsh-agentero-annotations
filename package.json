{
  "name": "dsh-agentero-annotations",
  "version": "0.1.3",
  "private": true,
  "description": "在Agentero的DSH阅读器中显示完整文字批注、按页筛选和页码跳转",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "README.md",
    "NOTICE.md",
    "src",
    "build.mjs",
    "install.mjs",
    "cordis.patch.yml",
    "scripts",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "install-plugin": "node install.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@poco-ai/agentero-dsh": "^0.1.5"
  },
  "peerDependenciesMeta": {
    "@poco-ai/agentero-dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@poco-ai/agentero-dsh-host",
        "@poco-ai/agentero-dsh-pdf",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yellkiin/dsh-agentero-annotations.git"
  },
  "homepage": "https://github.com/yellkiin/dsh-agentero-annotations#readme",
  "bugs": {
    "url": "https://github.com/yellkiin/dsh-agentero-annotations/issues"
  }
}
